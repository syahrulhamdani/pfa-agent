# Development and testing env file. Copy to .env and fill in real secrets locally;
# never commit real values.
DATABASE_URL=postgresql+asyncpg://pfa:pfa@localhost:5432/pfa
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=0
GEMINI_API_KEY=replace-me
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EXTRACT_MODEL=gemini-pro-latest
WEB_BASE_URL=http://localhost:5173
TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
LOG_USE_BASIC_FORMAT=true
# LangSmith observability. Off by default: traces include your messages and, in
# later slices, receipt contents, so turn it on deliberately.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pfa
