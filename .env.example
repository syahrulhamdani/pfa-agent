# Copy this file to .env and fill in the real values. .env is git-ignored: never commit
# real secrets. Then run `uv run --env-file .env pfa doctor`: it checks everything and
# says what to fix. The tests only need the placeholders below.

# The Postgres from docker-compose.yml (`docker compose up -d --wait db`).
DATABASE_URL=postgresql+asyncpg://pfa:pfa@localhost:5433/pfa
# From @BotFather in Telegram: send /newbot and copy the token.
TELEGRAM_BOT_TOKEN=replace-me
# The one chat pfa answers. Message your bot, then run
# `uv run --env-file .env pfa chat-id` and copy the id it prints.
TELEGRAM_CHAT_ID=0
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EXTRACT_MODEL=gemini-pro-latest
CATEGORIES_FILE=config/categories.json
# Signs sign-in links and sessions. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-me-with-at-least-32-random-characters
AUTH_LINK_TTL_MINUTES=10
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
WEB_BASE_URL=http://localhost:5173
TIMEZONE=Asia/Jakarta
# The weekly summary is sent on Mondays at this hour (0-23), in the timezone above.
SUMMARY_HOUR=8
LOG_LEVEL=INFO
LOG_USE_BASIC_FORMAT=true

# LangSmith observability. Off by default: traces include your messages and the
# receipt data pfa extracts, so turn it on deliberately. Receipt images are always
# redacted from traces (see src/pfa/core/tracing.py).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pfa
